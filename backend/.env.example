# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Database URL (Default SQLite for local dev, or Neon PostgreSQL for production)
# Local: sqlite:///./aura_skincare.db
# Neon Prod: postgresql://username:password@ep-xyz.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite:///./aura_skincare.db

# Allowed CORS Origins (comma-separated, or defaults handle localhost & *.vercel.app automatically)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-frontend.vercel.app

# Optional Resend API Key for real emails (leaves mock mode active if omitted)
# RESEND_API_KEY=re_xxxxxxxxxxxx
